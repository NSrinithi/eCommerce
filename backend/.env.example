NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mern_base
JWT_SECRET=GENERATE_WITH_NPM_RUN_SETUP
SESSION_DAYS=7
COOKIE_NAME=mern_base_session
# Exact browser origin; no trailing slash. Comma-separate only origins you own.
CLIENT_ORIGINS=http://localhost:5173
# Only set to 1 when behind ONE trusted reverse proxy.
TRUST_PROXY=0
# true: Express also serves frontend/dist (run npm run build first).
SERVE_CLIENT=false
